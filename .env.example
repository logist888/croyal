# Copy to .env and fill in. The MVP runs with NO env vars (in-memory store + dev auth).

# Server
PORT=3001

# Telegram bot token from @BotFather. When set, the server cryptographically
# verifies Telegram initData. When EMPTY, dev auth is enabled (browser testing).
BOT_TOKEN=

# Force-enable dev auth even if BOT_TOKEN is set (browser testing only). 1 = on.
ALLOW_DEV_AUTH=

# Client (Vite) — base URL of the server API. Defaults to http://localhost:3001.
VITE_API_BASE=http://localhost:3001

# Durable storage (PostgreSQL). When set, the server write-throughs all data to
# Postgres and hydrates from it on boot, so progress survives restarts. When
# UNSET, the game runs purely in memory (resets on restart). Use a free Neon or
# Supabase database, or Render's PG. SSL is enabled automatically for non-local hosts.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# (Roadmap) Redis for matchmaking/match state at scale — not required yet.
# REDIS_URL=redis://localhost:6379

# --- Anti-abuse rate limits (Этап 4.3), per client IP per 60s. Optional; these
# are the defaults. Raise if legit players hit 429, lower to tighten. ---
# RL_GLOBAL_MAX=240   # ceiling on all /api requests
# RL_AUTH_MAX=30      # stricter ceiling on /api/auth + /api/register

# --- Telemetry (Этап 4.1). When set, GET /api/admin/metrics returns the live
# funnel / retention / battle-length / card-winrate report; require this token via
# the `x-admin-token` header (or ?token=). Unset = the endpoint is disabled (404). ---
# ADMIN_TOKEN=choose-a-long-random-string
